# ─── Agent First IDE — Environment Configuration ─────────
# Copy this file to .env and fill in your keys.
#
#   cp .env.example .env
#

# ─── OpenAI / LLM Provider ───────────────────────────────
OPENAI_API_KEY=sk-...

# ─── Worker Vision-Language Model ─────────────────────────
# Optional. Falls back to OPENAI_API_KEY if not set.
WORKER_VLM_API_KEY=
WORKER_VLM_MODEL=gpt-4.1-mini

# ─── Supervisor LLM ──────────────────────────────────────
SUPERVISOR_LLM_MODEL=gpt-4.1-mini

# ─── Browser Runtime ─────────────────────────────────────
# Modes: LOCAL_NATIVE_CDP | ISOLATED_SERVER | REMOTE_WEBSOCKET
BROWSER_MODE=ISOLATED_SERVER
BROWSER_HEADLESS=true
LOCAL_CDP_ENDPOINT=http://localhost:9222
REMOTE_WEBSOCKET_URL=

# ─── Agent Safety ─────────────────────────────────────────
DRY_RUN_MODE=true
MAX_CYCLES=15
WORKER_CONFIDENCE_THRESHOLD=0.4
