# ─── Agent First IDE — Environment Configuration ─────────
# Copy this file to .env and fill in your keys.
#
#   cp .env.example .env
#

# ─── OpenAI / LLM Provider ───────────────────────────────
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=
# Optional comma/semicolon-delimited extra keys used automatically on provider failures.
OPENAI_API_KEY_FALLBACKS=

# ─── Google LLM Provider (Gemma / Gemini) ────────────────
# Use this for Gemma models on Google AI APIs.
GOOGLE_API_KEY=
GOOGLE_API_KEY_FALLBACKS=
# Backward compatibility alias (optional if GOOGLE_API_KEY is set)
GEMINI_API_KEY=
GEMINI_API_KEY_FALLBACKS=

# ─── Worker Vision-Language Model ─────────────────────────
# Optional. Falls back to OPENAI_API_KEY if not set.
WORKER_VLM_API_KEY=
WORKER_VLM_API_KEY_FALLBACKS=
WORKER_VLM_MODEL=gemma-4-27b-it
WORKER_VLM_FALLBACK_MODEL=gemma-3-27b-it
# Optional low-token selector model used in executor stage-B.
DOM_SELECTOR_MODEL=gemini-2.5-flash

# ─── Supervisor LLM ──────────────────────────────────────
SUPERVISOR_MODEL_API_KEY=
SUPERVISOR_MODEL_API_KEY_FALLBACKS=
SUPERVISOR_LLM_MODEL=gemma-4-27b-it
SUPERVISOR_FALLBACK_MODEL=gpt-4.1-mini

# ─── Browser Runtime ─────────────────────────────────────
# Modes: LOCAL_NATIVE_CDP | ISOLATED_SERVER | REMOTE_WEBSOCKET
BROWSER_MODE=LOCAL_NATIVE_CDP
BROWSER_HEADLESS=false
LOCAL_CDP_ENDPOINT=http://localhost:9222
REMOTE_WEBSOCKET_URL=
LOCAL_BROWSER_AUTOSTART=true
LOCAL_BROWSER_PREFERENCE=edge
LOCAL_BROWSER_STARTUP_TIMEOUT_SECONDS=18
LOCAL_BROWSER_FALLBACK_TO_ISOLATED=true
FORCE_VISIBLE_LOCAL_BROWSER=true

# ─── Human-Like Action Pacing ───────────────────────────
HUMAN_ACTION_DELAY_MIN_SECONDS=1.4
HUMAN_ACTION_DELAY_MAX_SECONDS=3.2

# ─── Agent Safety ─────────────────────────────────────────
DRY_RUN_MODE=true
AUTONOMOUS_CONTINUATION=true
MAX_CYCLES=15
WORKER_CONFIDENCE_THRESHOLD=0.4
PERSISTENT_THREAD_ID=reddit-main-session
WORKER_LLM_MIN_GAP_SECONDS=2.0
SUPERVISOR_LLM_MIN_GAP_SECONDS=2.5

# ─── LangSmith Tracing ────────────────────────────────────
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=agent-first-ide
LANGCHAIN_ENDPOINT=
