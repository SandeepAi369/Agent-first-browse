{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.SandeepAi369/agent-first-browse",
  "title": "Agent First Browse",
  "description": "Fast, token-efficient AI browser control MCP server with accessibility-tree perception.",
  "version": "0.1.0",
  "websiteUrl": "https://xel-studio.vercel.app",
  "repository": {
    "url": "https://github.com/SandeepAi369/Agent-first-browse",
    "source": "github"
  },
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "agent-first-browse",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "runtimeArguments": [
        {
          "type": "named",
          "name": "--from",
          "value": "agent-first-browse"
        },
        {
          "type": "positional",
          "value": "agent-eval-mcp"
        }
      ],
      "transport": {
        "type": "stdio"
      }
    }
  ]
}
